<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Landing page (ex3).

    A StackPane root keeps the card centred at any window size, which is what
    the resize requirement asks for: nothing is anchored to a corner and nothing
    stretches out of shape. The card is capped at 440px and sized to its own
    content, so growing the window only adds space around it.
-->
<StackPane fx:id="loginRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.LoginController"
           minHeight="420" minWidth="420" styleClass="login-root">

   <padding>
      <Insets bottom="24" left="24" right="24" top="24" />
   </padding>

   <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="440" spacing="16" styleClass="login-card">

      <padding>
         <Insets bottom="30" left="34" right="34" top="30" />
      </padding>

      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="headline" text="Guess Market" />

      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="login-subtitle"
             text="Enter your name to join the market" wrapText="true" />

      <Region minHeight="4" />

      <VBox spacing="6">
         <Label styleClass="muted-label" text="User name" />
         <TextField fx:id="userNameField" onAction="#login" promptText="letters and digits only"
                    styleClass="login-field" />
      </VBox>

      <!--
          managed="false" as well as visible="false": an invisible but still
          managed label keeps its height, which would leave a gap in the card
          whenever there is no error to show.
      -->
      <Label fx:id="errorLabel" managed="false" maxWidth="1.7976931348623157E308"
             styleClass="login-error" visible="false" wrapText="true" />

      <HBox alignment="CENTER" spacing="10">

         <Button fx:id="loginBtn" defaultButton="true" maxWidth="1.7976931348623157E308"
                 onAction="#login" styleClass="login-button" text="Log in" HBox.hgrow="ALWAYS" />

      </HBox>

      <Region minHeight="2" />

      <HBox alignment="CENTER" spacing="8">
         <Label styleClass="muted-label" text="Theme" />
         <ComboBox fx:id="themeComboBox" minWidth="120" onAction="#setTheme" prefWidth="120" />
      </HBox>

      <Label fx:id="serverLabel" alignment="CENTER" maxWidth="1.7976931348623157E308"
             styleClass="login-footnote" text="" />

   </VBox>

</StackPane>
