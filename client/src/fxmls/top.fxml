<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

   <VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10" styleClass="top-bar" fx:controller="controllers.TopController">

      <padding>
         <Insets bottom="12" left="18" right="18" top="14" />
      </padding>

      <HBox alignment="CENTER" spacing="10">

         <!-- left and right groups share one width, so the title stays centred -->
         <HBox alignment="CENTER_LEFT" maxWidth="300" minWidth="300" prefWidth="300" spacing="10">

            <Label fx:id="activeUserLabel" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" styleClass="active-user, active-user-none" text="No active user" HBox.hgrow="ALWAYS" />

            <Button fx:id="logoutBtn" minWidth="-Infinity" onAction="#logout" styleClass="load-file-button" text="Log out" />

         </HBox>

         <Region HBox.hgrow="ALWAYS" />

         <Label fx:id="headline" alignment="CENTER" styleClass="headline" text="Guess Market" />

         <Region HBox.hgrow="ALWAYS" />

         <HBox alignment="CENTER_RIGHT" maxWidth="300" minWidth="300" prefWidth="300" spacing="10">

            <CheckBox fx:id="animationsCheckBox" minWidth="110" onAction="#toggleAnimations" styleClass="animations-check" text="Animations" />

            <ComboBox fx:id="themeComboBox" minWidth="130" onAction="#setTheme" prefWidth="130" promptText="Theme" />

         </HBox>

      </HBox>

   </VBox>
