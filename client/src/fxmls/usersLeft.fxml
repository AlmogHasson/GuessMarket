<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="card" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.usersTab.UsersLeftController">

      <padding>
         <Insets bottom="12" left="12" right="12" top="12" />
      </padding>

      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="users-title" text="Users" />


      <TableView fx:id="usersTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
         </columnResizePolicy>


         <columns>

            <TableColumn fx:id="userListNameCol" minWidth="40" prefWidth="50" text="Name" />
            <TableColumn fx:id="userListAccountBalanceCol" minWidth="40" prefWidth="140" text="Account Balance" />
            <TableColumn fx:id="userListMarketMakerCol" text="Is Market Maker" />

         </columns>

      </TableView>

      <!-- ACCOUNT DETAILS (active user) + balance strip with deposit button -->

      <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>

         <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="section-title" text="Account Details" />

         <TableView fx:id="accountDetailsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="accountEventCol" minWidth="40" prefWidth="70" text="Event" />
               <TableColumn fx:id="accountActivityCol" minWidth="40" prefWidth="110" text="Activity" />
               <TableColumn fx:id="accountAmountCol" minWidth="40" prefWidth="60" text="Amount" />
               <TableColumn fx:id="accountBalanceCol" text="Balance" />
            </columns>
         </TableView>

         <HBox alignment="CENTER_LEFT" spacing="10" styleClass="balance-card">
            <VBox>
               <Label styleClass="muted-label" text="Account Balance" />
               <Label fx:id="accountBalanceLabel" styleClass="balance-value" text="0.00" />
            </VBox>
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="depositBtn" onAction="#deposit" text="Deposit" />
         </HBox>

      </VBox>

   </VBox>
