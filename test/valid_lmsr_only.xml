<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX3-Schema.xsd">
	<GM-events>
		<GM-event name="Bitcoin above 100k">
			<description>Will Bitcoin close above 100,000 USD on December 31st 2026?</description>
			<commission type="on-purchase">5</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>150</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
		<GM-event name="Election turnout">
			<description>Will voter turnout exceed 70 percent in the next national election?</description>
			<commission type="on-close">12</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>300</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
		<GM-event name="Snow in Jerusalem">
			<description>Will it snow in Jerusalem this winter?</description>
			<commission type="on-close">8</commission>
			<GM-options>
				<GM-option>Yes</GM-option>
				<GM-option>No</GM-option>
			</GM-options>
			<GM-method>
				<GM-LMSR>
					<b>100</b>
				</GM-LMSR>
			</GM-method>
		</GM-event>
	</GM-events>
</Guess-Market>
