<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="card" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.UsersLeftController">

      <padding>
         <Insets bottom="12" left="12" right="12" top="12" />
      </padding>

      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="users-title" text="Users" />


      <TableView fx:id="usersTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
         </columnResizePolicy>


         <columns>

            <TableColumn fx:id="userListNameCol" minWidth="40" prefWidth="50" text="Name" />

            <TableColumn fx:id="userListAccountBalanceCol" minWidth="40" prefWidth="140" text="Account Balance" />

         </columns>

      </TableView>

   </VBox>
