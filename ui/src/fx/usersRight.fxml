<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

   <VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.UsersRightController" spacing="12">

      <padding>
         <Insets bottom="12" left="12" right="12" top="12" />
      </padding>


      <HBox alignment="CENTER">

         <Region HBox.hgrow="ALWAYS" />

         <Label styleClass="page-title" text="Single User Details" />

         <Region HBox.hgrow="ALWAYS" />

         <VBox alignment="CENTER" styleClass="balance-card">

            <Label styleClass="muted-label" text="Account Balance" />

            <Label fx:id="balance" styleClass="balance-value" text="0.00" />

         </VBox>

      </HBox>


      <!-- USER EVENTS -->

      <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>

         <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="section-title" text="Events Participation / Owner" />


         <TableView fx:id="userEventsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="userEventCol" minWidth="40" prefWidth="180" text="Event" />
               <TableColumn fx:id="userEventRoleCol" minWidth="40" prefWidth="100" text="Role" />
               <TableColumn fx:id="userEventStatusCol" minWidth="80" prefWidth="110" text="Event Status" />
               <TableColumn fx:id="userEventSharesCol" minWidth="40" prefWidth="90" text="Shares" />
            </columns>
         </TableView>

      </VBox>


      <!-- USER SINGLE EVENT DETAILS -->

      <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">

         <padding>
            <Insets bottom="12" left="12" right="12" top="12" />
         </padding>

         <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="section-title" text="Single event details and trade" />

         <!-- LMSR view: trading history -->
         <TableView fx:id="lmsrEventTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>
            <columns>
               <TableColumn fx:id="lmsrEventOptionCol" minWidth="40" prefWidth="140" text="Option" />
               <TableColumn fx:id="lmsrSharesCol" minWidth="40" prefWidth="90" text="Shares" />
               <TableColumn fx:id="lmsrPaidCol" minWidth="40" prefWidth="100" text="Total Paid" />
               <TableColumn fx:id="lmsrCommissionCol" minWidth="40" prefWidth="110" text="Total Commission Paid" />
            </columns>
         </TableView>
         <!-- Order Book view: current position per option -->
         <TableView fx:id="orderBookPositionTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS" visible="false" managed="false">
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
            </columnResizePolicy>

            <columns>
               <TableColumn fx:id="obOptionCol" minWidth="40" prefWidth="180" text="Option" />
               <TableColumn fx:id="obSharesHeldCol" minWidth="40" prefWidth="120" text="Shares Held" />
               <TableColumn fx:id="obPaidCol" minWidth="40" prefWidth="120" text="Total Paid" />
               <TableColumn fx:id="obCommissionCol" minWidth="80" prefWidth="110" text="Commission Paid" />
            </columns>
         </TableView>

         <!-- Shared summary lines: commissionPaid (order book only) + closed-event summary (both) -->
         <VBox fx:id="participationSummary"
               alignment="CENTER"
               spacing="6"
               maxWidth="1.7976931348623157E308"
               styleClass="participation-summary">

            <Label fx:id="commissionSummaryLabel"
                   alignment="CENTER"
                   maxWidth="1.7976931348623157E308"
                   styleClass="participation-summary-main" />

            <Label fx:id="closedSummaryLabel"
                   alignment="CENTER"
                   maxWidth="1.7976931348623157E308"
                   styleClass="participation-summary-secondary" />

         </VBox>

      </VBox>

   </VBox>
