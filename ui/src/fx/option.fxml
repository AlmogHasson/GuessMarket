<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" style="-fx-background-color: white;                                                      -fx-background-radius: 10;                                                      -fx-border-color: #e5e7eb;                                                      -fx-border-radius: 10;" GridPane.columnIndex="0" GridPane.rowIndex="0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="12" left="12" right="12" top="12" />
    </padding>


    <HBox alignment="CENTER" spacing="16">

        <Label style="-fx-text-fill: #6b7280;" text="Value:" />

        <Label style="-fx-font-weight: bold;" text="0.00" />

        <Label style="-fx-text-fill: #6b7280;" text="Shares:" />

        <Label style="-fx-font-weight: bold;" text="0" />

    </HBox>


    <TableView VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn prefWidth="100" text="User" />

            <TableColumn prefWidth="80" text="Shares" />

            <TableColumn prefWidth="90" text="Paid" />

        </columns>

    </TableView>

</VBox>
