<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10" style="-fx-background-color: white;                                                      -fx-background-radius: 10;                                                      -fx-border-color: #e5e7eb;                                                      -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="12" left="12" right="12" top="12" />
    </padding>


    <HBox alignment="CENTER" spacing="16">

        <Label style="-fx-text-fill: #6b7280;" text="Value:" />

        <Label fx:id="optionValue" style="-fx-font-weight: bold;" text="0.00" />

        <Label style="-fx-text-fill: #6b7280;" text="Shares:" />

        <Label fx:id="optionShares" style="-fx-font-weight: bold;" text="0" />

    </HBox>


    <TableView minWidth="0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" fx:id="holdersTable" VBox.vgrow="ALWAYS">
       <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
       </columnResizePolicy>


        <columns>

            <TableColumn minWidth="40" fx:id="holderUserCol" prefWidth="100" text="User" />

            <TableColumn minWidth="40" fx:id="holderSharesCol" prefWidth="80" text="Shares" />

            <TableColumn minWidth="40" fx:id="holderPaidCol" prefWidth="90" text="Paid" />

        </columns>

    </TableView>

</VBox>
