<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.MainController">

   <!--
       The original order-book details layout is kept intact, but it is not
       placed in the live scene graph while the LMSR layout is being designed.
       This prevents Scene Builder from drawing two layouts on top of each other.
       The controller can place orderBookDetailsPane inside eventDetailsContent
       whenever an ORDER_BOOK event is selected.
   -->
   <fx:define>
      <GridPane fx:id="orderBookDetailsPane" hgap="12" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" vgap="12">
         <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
         </columnConstraints>

         <rowConstraints>
            <RowConstraints percentHeight="50" />
            <RowConstraints percentHeight="50" />
         </rowConstraints>

         <!-- PARTICIPATIONS -->
         <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10" styleClass="card" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
            <padding>
               <Insets bottom="12" left="12" right="12" top="12" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
               <Label styleClass="section-title" text="Participations information" />
               <Region HBox.hgrow="ALWAYS" />
               <Label styleClass="muted-label" text="Event Balance:" />
               <Label fx:id="eventBalance" styleClass="strong-label" text="0.00" />
               <Label styleClass="muted-label" text="Commission Paid:" />
               <Label fx:id="comissionPaid" styleClass="strong-label" text="0.00" />
            </HBox>

            <TableView fx:id="participationTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="participationUserCol" minWidth="40" prefWidth="100" text="User" />
                  <TableColumn fx:id="participationOptionCol" minWidth="40" prefWidth="120" text="Option" />
                  <TableColumn fx:id="participationSharesCol" minWidth="40" prefWidth="80" text="Shares" />
                  <TableColumn fx:id="participationPaidCol" minWidth="40" prefWidth="90" text="Paid" />
                  <TableColumn fx:id="participationCommissionCol" minWidth="40" prefWidth="100" text="Commission" />
               </columns>
            </TableView>
         </VBox>

         <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <children>
               <Label fx:id="option1Label" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="option-title" text="Option 1" />
               <VBox fx:id="option1VBox" spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                  <padding>
                     <Insets bottom="12" left="12" right="12" top="12" />
                  </padding>
                  <HBox alignment="CENTER" spacing="16">
                     <Label styleClass="muted-label" text="Value:" />
                     <Label fx:id="option1Value" styleClass="strong-label" text="0.00" />
                     <Label styleClass="muted-label" text="Shares:" />
                     <Label fx:id="option1Shares" styleClass="strong-label" text="0" />
                  </HBox>
                  <TableView fx:id="option1Table" mouseTransparent="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="option1UserCol" sortable="false" minWidth="40" prefWidth="100" text="User" />
                        <TableColumn fx:id="option1SharesCol" sortable="false" minWidth="40" prefWidth="80" text="Shares" />
                        <TableColumn fx:id="option1PaidCol" sortable="false" minWidth="40" prefWidth="90" text="Paid" />
                     </columns>
                  </TableView>
               </VBox>
            </children>
         </VBox>

         <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1">
            <children>
               <Label fx:id="option2Label" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="option-title" text="Option 2" />
               <VBox fx:id="option2VBox" spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                  <padding>
                     <Insets bottom="12" left="12" right="12" top="12" />
                  </padding>
                  <HBox alignment="CENTER" spacing="16">
                     <Label styleClass="muted-label" text="Value:" />
                     <Label fx:id="option2Value" styleClass="strong-label" text="0.00" />
                     <Label styleClass="muted-label" text="Shares:" />
                     <Label fx:id="option2Shares" styleClass="strong-label" text="0" />
                  </HBox>
                  <TableView fx:id="option2Table" mouseTransparent="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="option2UserCol" sortable="false" minWidth="40" prefWidth="100" text="User" />
                        <TableColumn fx:id="option2SharesCol" sortable="false" minWidth="40" prefWidth="80" text="Shares" />
                        <TableColumn fx:id="option2PaidCol" sortable="false" minWidth="40" prefWidth="90" text="Paid" />
                     </columns>
                  </TableView>
               </VBox>
            </children>
         </VBox>
      </GridPane>
   </fx:define>

   <!-- ===================== TOP ===================== -->

   <top>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10" styleClass="top-bar">

         <padding>
            <Insets bottom="12" left="18" right="18" top="14" />
         </padding>

               <HBox alignment="CENTER" spacing="10">

                  <!-- mirrors the controls on the right so the title is truly centred -->
                  <Region maxWidth="250" minWidth="250" prefWidth="250" />

                  <Region HBox.hgrow="ALWAYS" />

                  <Label fx:id="headline" alignment="CENTER" styleClass="headline" text="Guess Market" />

                  <Region HBox.hgrow="ALWAYS" />

                  <CheckBox fx:id="animationsCheckBox" minWidth="110" onAction="#toggleAnimations" selected="true" styleClass="animations-check" text="Animations" />

                  <ComboBox fx:id="themeComboBox" minWidth="130" onAction="#setTheme" prefWidth="130" promptText="Theme" />

               </HBox>

               <HBox alignment="CENTER_LEFT" spacing="10">

                  <Button fx:id="loadFileBtn" maxHeight="1.7976931348623157E308" onAction="#loadFile" styleClass="load-file-button" text="Load File" />

                  <VBox maxWidth="1.7976931348623157E308" spacing="6" HBox.hgrow="ALWAYS">

                     <Label fx:id="filePath" maxWidth="1.7976931348623157E308" styleClass="file-path" text="Currently Loaded File path: " />

                     <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" progress="0.0" />

                  </VBox>

               </HBox>

      </VBox>
   </top>


   <!-- ===================== CENTER ===================== -->

   <center>

      <TabPane tabClosingPolicy="UNAVAILABLE">

         <tabs>

            <!-- =====================================================
                                 EVENTS TAB
                 ===================================================== -->

            <Tab fx:id="eventsTab" text="Events">

               <content>

                  <SplitPane dividerPositions="0.48">

                     <items>

                        <!-- ================= LEFT SIDE ================= -->

                        <VBox spacing="12" styleClass="card">

                           <padding>
                              <Insets bottom="12" left="12" right="12" top="12" />
                           </padding>

                           <HBox spacing="8">

                              <ComboBox fx:id="methodFilter" maxWidth="1.7976931348623157E308" onAction="#onMethodFilterChanged" promptText="Method" HBox.hgrow="ALWAYS" />

                              <ComboBox fx:id="statusFilter" maxWidth="1.7976931348623157E308" onAction="#onStatusFilterChanged" promptText="Status" HBox.hgrow="ALWAYS" />

                              <ComboBox fx:id="commissionFilter" maxWidth="1.7976931348623157E308" onAction="#onCommissionTypeFilterChanged" promptText="Commission" HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="commissionTypeFilter" layoutX="365.0" layoutY="10.0" maxWidth="1.7976931348623157E308" onAction="#onCommissionFilterChanged" promptText="Commission Type" />

                           </HBox>


                           <TableView fx:id="eventsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" prefHeight="968.0" prefWidth="606.0" styleClass="events-table" VBox.vgrow="ALWAYS">
                              <columnResizePolicy>
                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                              </columnResizePolicy>


                              <columns>

                                 <TableColumn fx:id="eventListIdCol" minWidth="31.0" prefWidth="35.0" text="#" />

                                 <TableColumn fx:id="eventListEventCol" minWidth="40" prefWidth="148.0" text="Event" />

                                 <TableColumn fx:id="eventListMethodCol" minWidth="40" prefWidth="94.0" text="Method" />

                                 <TableColumn fx:id="eventListStatusCol" minWidth="40" prefWidth="82.0" text="Status" />

                                 <TableColumn fx:id="eventListCommissionCol" minWidth="40" prefWidth="94.0" text="Commission" />
                                 <TableColumn fx:id="eventListCommissionTypeCol" minWidth="40" prefWidth="126.0" text="Commission Type" />

                              </columns>

                           </TableView>

                        </VBox>


                        <!-- ================= RIGHT SIDE ================= -->

                        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="360" spacing="10">

                           <padding>
                              <Insets bottom="12" left="12" right="12" top="12" />
                           </padding>

                           <HBox alignment="CENTER" spacing="10">
                              <!-- mirrors the button so the title stays centred -->
                              <Region maxWidth="120" minWidth="120" prefWidth="120" />
                              <Label fx:id="eventDetailsTitle" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="page-title" text="Event details and trade" HBox.hgrow="ALWAYS" />
                              <Button fx:id="closeEventBtn" minWidth="120" onAction="#closeEvent" prefWidth="120" styleClass="danger-button" text="Close Event" />
                           </HBox>

                           <!--
                               Only the active LMSR layout is in the live scene graph.
                               The original order-book layout is stored in fx:define above,
                               so Scene Builder does not overlap or compress the two views.
                           -->
                           <StackPane fx:id="eventDetailsContent" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0" minWidth="0" VBox.vgrow="ALWAYS">

                              <VBox fx:id="lmsrDetailsPane" fillWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0" minWidth="0" spacing="10">

                                 <!-- General LMSR event information. Labels and values use the strong style for readability. -->
                                 <GridPane hgap="12" maxWidth="1.7976931348623157E308" styleClass="card" vgap="8">
                                    <padding>
                                       <Insets bottom="10" left="12" right="12" top="10" />
                                    </padding>

                                    <columnConstraints>
                                       <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="27" />
                                       <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="27" />
                                       <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="46" />
                                    </columnConstraints>

                                    <VBox minWidth="0" spacing="2" styleClass="info-cell">
                                       <Label styleClass="strong-label" text="Event Name" />
                                       <Label fx:id="lmsrEventName" maxWidth="1.7976931348623157E308" text="N/A" wrapText="true" />
                                    </VBox>

                                    <VBox minWidth="0" spacing="2" styleClass="info-cell" GridPane.columnIndex="1">
                                       <Label styleClass="strong-label" text="Status" />
                                       <Label fx:id="lmsrEventStatus" maxWidth="1.7976931348623157E308" text="N/A" />
                                    </VBox>

                                    <VBox minWidth="0" spacing="2" styleClass="info-cell" GridPane.rowIndex="1">
                                       <Label styleClass="strong-label" text="Account Balance" />
                                       <Label fx:id="lmsrAccountBalance" maxWidth="1.7976931348623157E308" text="N/A" />
                                    </VBox>

                                    <VBox minWidth="0" spacing="2" styleClass="info-cell" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                       <Label styleClass="strong-label" text="Total Commission Paid" />
                                       <Label fx:id="lmsrTotalCommissionPaid" maxWidth="1.7976931348623157E308" text="N/A" />
                                    </VBox>
                                    <!-- Description now lives beside the event facts instead of below them. -->
                                    <VBox fillWidth="true" maxHeight="1.7976931348623157E308" minWidth="0" spacing="2" styleClass="info-cell" GridPane.columnIndex="2" GridPane.rowSpan="2" GridPane.vgrow="ALWAYS">
                                       <Label styleClass="strong-label" text="Description" />
                                       <TextArea fx:id="lmsrEventDescription" editable="false" focusTraversable="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="52" mouseTransparent="true" prefHeight="62" styleClass="description-area" wrapText="true" VBox.vgrow="ALWAYS" />
                                    </VBox>
                                    <rowConstraints>
                                       <RowConstraints />
                                       <RowConstraints />
                                    </rowConstraints>
                                 </GridPane>

                                 <!-- Two compact option tables. Each table contains one row: value and total shares. -->
                                 <GridPane fx:id="lmsrOptionsGrid" hgap="12" maxHeight="132" maxWidth="1.7976931348623157E308" minHeight="118" prefHeight="126">
                                    <columnConstraints>
                                       <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="50" />
                                       <ColumnConstraints hgrow="ALWAYS" minWidth="0" percentWidth="50" />
                                    </columnConstraints>

                                    <VBox fx:id="lmsrOption1Box" fillWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" prefWidth="290.0" spacing="4">
                                       <Label fx:id="lmsrOption1Label" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="option-title" text="Option 1" />
                                       <TableView fx:id="lmsrOption1Table" fixedCellSize="30" focusTraversable="false" maxHeight="66" maxWidth="1.7976931348623157E308" minHeight="60" minWidth="0" mouseTransparent="true" prefHeight="62" styleClass="card, option-table" VBox.vgrow="ALWAYS">
                                          <columnResizePolicy>
                                             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                          </columnResizePolicy>
                                          <columns>
                                             <TableColumn fx:id="lmsrOption1ValueCol" minWidth="0" prefWidth="110" reorderable="false" sortable="false" text="Current Value" />
                                             <TableColumn fx:id="lmsrOption1TotalSharesCol" minWidth="0" prefWidth="160" reorderable="false" sortable="false" text="Total Shares Bought" />
                                          </columns>
                                       </TableView>

                                       <HBox alignment="CENTER" spacing="6">
                                          <TextField fx:id="lmsrOption1BetField" minWidth="0" promptText="Shares" styleClass="bet-field" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="lmsrOption1BetBtn" minWidth="0" onAction="#placeBetOption1" styleClass="bet-button" text="Place the bet" />
                                       </HBox>
                                    </VBox>

                                    <VBox fx:id="lmsrOption2Box" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" spacing="4" GridPane.columnIndex="1">
                                       <Label fx:id="lmsrOption2Label" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="option-title" text="Option 2" />
                                       <TableView fx:id="lmsrOption2Table" fixedCellSize="30" focusTraversable="false" maxHeight="66" maxWidth="1.7976931348623157E308" minHeight="60" minWidth="0" mouseTransparent="true" prefHeight="62" styleClass="card, option-table" VBox.vgrow="ALWAYS">
                                          <columnResizePolicy>
                                             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                          </columnResizePolicy>
                                          <columns>
                                             <TableColumn fx:id="lmsrOption2ValueCol" minWidth="0" prefWidth="110" reorderable="false" sortable="false" text="Current Value" />
                                             <TableColumn fx:id="lmsrOption2TotalSharesCol" minWidth="0" prefWidth="160" reorderable="false" sortable="false" text="Total Shares Bought" />
                                          </columns>
                                       </TableView>

                                       <HBox alignment="CENTER" spacing="6">
                                          <TextField fx:id="lmsrOption2BetField" minWidth="0" promptText="Shares" styleClass="bet-field" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="lmsrOption2BetBtn" minWidth="0" onAction="#placeBetOption2" styleClass="bet-button" text="Place the bet" />
                                       </HBox>
                                    </VBox>
                                    <rowConstraints>
                                       <RowConstraints />
                                    </rowConstraints>
                                 </GridPane>

                                 <!-- Original participation table restored for LMSR; only Commission is removed. -->
                                 <VBox fillWidth="true" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0" minWidth="0" spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
                                    <padding>
                                       <Insets bottom="12" left="12" right="12" top="10" />
                                    </padding>

                                    <Label styleClass="section-title" text="Participations information" />

                                    <TableView fx:id="lmsrParticipationTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0" minWidth="0" VBox.vgrow="ALWAYS">
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                       </columnResizePolicy>
                                       <columns>
                                          <TableColumn fx:id="lmsrParticipationUserCol" minWidth="80" prefWidth="130" text="User" />
                                          <TableColumn fx:id="lmsrParticipationOptionCol" minWidth="100" prefWidth="180" text="Option" />
                                          <TableColumn fx:id="lmsrParticipationSharesCol" minWidth="75" prefWidth="100" text="Shares" />
                                          <TableColumn fx:id="lmsrParticipationPaidCol" minWidth="75" prefWidth="110" text="Paid" />
                                       </columns>
                                    </TableView>
                                 </VBox>

                              </VBox>
                           </StackPane>

                        </VBox>

                     </items>

                  </SplitPane>

               </content>

            </Tab>


            <!-- =====================================================
                                  USERS TAB
                 ===================================================== -->

            <Tab fx:id="usersTab" text="Users">

               <content>

                  <SplitPane dividerPositions="0.27">

                     <items>

                        <!-- USERS LIST -->

                        <VBox spacing="12" styleClass="card">

                           <padding>
                              <Insets bottom="12" left="12" right="12" top="12" />
                           </padding>

                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="users-title" text="Users" />


                           <TableView fx:id="usersTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
                              <columnResizePolicy>
                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                              </columnResizePolicy>


                              <columns>

                                 <TableColumn fx:id="userListIdCol" minWidth="40" prefWidth="50" text="#" />

                                 <TableColumn fx:id="userListUserCol" minWidth="40" prefWidth="140" text="User" />

                                 <TableColumn fx:id="userListTypeCol" minWidth="40" prefWidth="100" text="Type" />

                              </columns>

                           </TableView>

                        </VBox>


                        <!-- USER DETAILS -->

                        <VBox spacing="12">

                           <padding>
                              <Insets bottom="12" left="12" right="12" top="12" />
                           </padding>


                           <HBox alignment="CENTER">

                              <Region HBox.hgrow="ALWAYS" />

                              <Label styleClass="page-title" text="Single User Details" />

                              <Region HBox.hgrow="ALWAYS" />

                              <VBox alignment="CENTER" styleClass="balance-card">

                                 <Label styleClass="muted-label" text="Account Balance" />

                                 <Label fx:id="balance" styleClass="balance-value" text="0.00" />

                              </VBox>

                           </HBox>


                           <!-- USER EVENTS -->

                           <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">

                              <padding>
                                 <Insets bottom="12" left="12" right="12" top="12" />
                              </padding>

                              <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="section-title" text="Events Participation / Owner" />


                              <TableView fx:id="userEventsTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                 </columnResizePolicy>


                                 <columns>

                                    <TableColumn fx:id="userEventCol" minWidth="40" prefWidth="180" text="Event" />

                                    <TableColumn fx:id="userEventRoleCol" minWidth="40" prefWidth="100" text="Role" />

                                    <TableColumn fx:id="userEventSharesCol" minWidth="40" prefWidth="90" text="Shares" />

                                    <TableColumn fx:id="userEventInvestmentCol" minWidth="40" prefWidth="110" text="Investment" />

                                 </columns>

                              </TableView>

                           </VBox>


                           <!-- USER EVENT DETAILS -->

                           <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">

                              <padding>
                                 <Insets bottom="12" left="12" right="12" top="12" />
                              </padding>

                              <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="section-title" text="Single event details and trade" />


                              <TableView fx:id="singleEventTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="0" VBox.vgrow="ALWAYS">
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                 </columnResizePolicy>


                                 <columns>

                                    <TableColumn fx:id="singleEventOptionCol" minWidth="40" prefWidth="140" text="Option" />

                                    <TableColumn fx:id="singleEventSharesCol" minWidth="40" prefWidth="90" text="Shares" />

                                    <TableColumn fx:id="singleEventPaidCol" minWidth="40" prefWidth="100" text="Paid" />

                                    <TableColumn fx:id="singleEventCommissionCol" minWidth="40" prefWidth="110" text="Commission" />

                                 </columns>

                              </TableView>

                           </VBox>

                        </VBox>

                     </items>

                  </SplitPane>

               </content>

            </Tab>

         </tabs>

      </TabPane>

   </center>

</BorderPane>
